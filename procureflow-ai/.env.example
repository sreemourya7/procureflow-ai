# Offline is the default. Set environment variables in your shell; this file is NOT auto-loaded.
PROCUREFLOW_MODE=offline
# Optional bearer token and separate human-review token. Set before remote deployment.
PROCUREFLOW_API_TOKEN=
PROCUREFLOW_REVIEWER_TOKEN=
# Live mode uses an OpenAI-compatible Chat Completions tool-calling endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
# Optional user-supplied model prices; never assume current provider prices.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
